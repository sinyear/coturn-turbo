# =============================================================================
# coturn-turbo 配置模板 (v2.0)
# 
# 本文件展示了 coturn-turbo 的所有核心和可选配置项。
# 您可以将此文件复制到 /etc/turnserver.conf 并根据需要进行修改。
#
# 详细文档: docs/TURBO.md
# =============================================================================

# =============================================================================
# 1. 基础 TURN 配置 (与原生 coturn 完全兼容)
# =============================================================================

# 监听端口 — Turbo 模式下所有流量复用到此端口
listening-port=3478

# 监听 IP，0.0.0.0 表示所有接口
listening-ip=0.0.0.0

# ---------------------------------------------------------------------------
# relay-ip / external-ip — 云服务器与自建机房配置方式不同，请按实际情况选择
# ---------------------------------------------------------------------------
#
# 【自建机房 / 公网 IP 直接绑定在网卡上】
#   relay-ip 直接填公网 IP，无需 external-ip
#
#   relay-ip=203.0.113.1
#
# 【云服务器（腾讯云 / 阿里云 / AWS / GCP 等弹性公网 IP）】
#   云服务器的公网 IP 通过 NAT 映射，并不绑定在任何本地网卡上。
#   若将 relay-ip 设为公网 IP，bind(2) 会返回 EADDRNOTAVAIL (errno=99)。
#   正确做法：relay-ip 填私网 IP（网卡实际地址），external-ip 填公网/私网映射。
#
#   relay-ip=10.0.0.1               # 私网 IP (ip addr show 查看)
#   external-ip=122.51.14.87/10.0.0.1  # 公网IP/私网IP
#
# Turbo 会将 Allocate 响应中的 relay 端口统一覆盖为 3478，
# 客户端最终看到的 relay 地址为 external-ip 中的公网 IP:3478。
# ---------------------------------------------------------------------------

# 示例（请根据实际环境二选一并取消注释）：
relay-ip=10.0.0.1
# external-ip=122.51.14.87/10.0.0.1

# 认证域
realm=north.example.com

# 使用 long-term credential 机制 (推荐)
lt-cred-mech

# 静态用户密码 (测试用，生产应使用 REST API 或数据库)
user=test:test123

# 可选：TLS/DTLS 证书
# cert=/etc/turn/cert.pem
# pkey=/etc/turn/key.pem

# 可选：rest-api-secret 用于动态鉴权
# use-auth-secret
# static-auth-secret=your_shared_secret

# =============================================================================
# 2. Turbo 核心配置
# =============================================================================

# 启用 Turbo 模式 (必须)
turbo

# 网络后端选择:
#   io_uring  - 高性能异步 I/O，默认选项，推荐生产使用
#   af_xdp    - 极致性能内核旁路，实验性，需内核 ≥5.4 且网卡驱动支持
turbo-backend=io_uring

# 启用 L1 快速缓存预热 (强烈推荐)
# 在 Allocation 成功时立即预热 L1 缓存，确保 Send Indication 首包延迟不退化
turbo-l1-warmup enable

# Admin API 监听端口 (用于监控和管理)
turbo-api-port=8080

# 限制 API 仅监听本地地址 (安全建议)
# turbo-api-listen-ip=127.0.0.1

# =============================================================================
# 3. 流量整形与安全
# =============================================================================

# STUN 信令包速率限制 (每秒最大包数)
# 防止单端口 DDoS 放大，默认 2000 pps
# turbo-stun-pps-limit 2000

# STUN 信令包突发容忍 (默认 4000)
# turbo-stun-burst-limit 4000

# =============================================================================
# 4. AF_XDP 后端配置 (仅在 turbo-backend=af_xdp 时有效)
# =============================================================================

# XDP 工作模式:
#   auto  - 自动选择最佳模式 (推荐)，先尝试 drv，失败则降为 skb
#   drv   - 网卡驱动原生零拷贝，性能最高，需要网卡驱动支持
#   skb   - 通用 SKB 回退模式，兼容性最好，性能略低于 drv
# turbo-afxdp-mode=auto

# 绑定到 AF_XDP 的物理网卡接口名称
# turbo-xdp-iface=eth0

# AF_XDP 保险丝：连续 RX Ring 满载触发降级的秒数 (默认 3)
# turbo-afxdp-fuse-timeout 3

# =============================================================================
# 5. 房间广播功能 (可选，按需启用)
# =============================================================================

# 启用房间广播
# turbo-rooms

# 房间身份提供者类型:
#   static      - 从 username 直接解析 roomID:memberID (仅测试用)
#   token_hmac  - 使用 HMAC-SHA256 签名的 JWT-like Token 进行验证 (推荐生产)
#   lua_script  - 调用自定义 Lua 脚本解析房间信息
# turbo-room-id-provider token_hmac

# [token_hmac 专用] 与信令服务共享的密钥，用于验证 Token 签名
# 请务必修改为强随机字符串，并确保与信令服务一致
# turbo-room-token-secret super_secret_key_change_me

# [token_hmac 专用] Token 默认过期时间，单位秒 (默认 3600)
# turbo-room-token-expiry 3600

# [lua_script 专用] 自定义 Lua 脚本的绝对路径
# turbo-room-lua-script /etc/turn/room_extractor.lua

# 房间成员上限 (硬限制，防止广播风暴，默认 50)
# turbo-room-max-members 50

# =============================================================================
# 6. 审计日志
# =============================================================================

# 审计事件流 Unix Socket 路径
# 启用后每个转发的数据包会产生一条 JSON 审计记录
# turbo-audit-log unix:///var/run/turn-audit.sock

# 审计环形缓冲区大小 (条目数，默认 4096)
# turbo-audit-buf-size 4096

# AF_XDP 元数据镜像 (将旁路流量的元数据推回内核安全栈，性能开销约 3%)
# turbo-audit-mirror enable

# =============================================================================
# 7. 日志
# =============================================================================

# 启用详细日志
verbose

# 日志文件路径
log-file=/var/log/turnserver/turbo.log

# 单文件日志替代 syslog
simple-log