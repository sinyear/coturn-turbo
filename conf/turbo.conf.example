# ============================================================
# coturn-turbo 配置示例（Turbo 高性能模式）
# ============================================================
# 本配置用于 Turbo 模式构建（编译时 CFLAGS 包含 -DTURN_USE_DPDK 或 -DTURN_USE_AFXDP）
#
# 使用方式:
#   turnserver -c turnserver.conf
#
# 或使用命令行参数覆盖:
#   turnserver --turbo --turbo-api-port 9999 -o -a -f \
#       --user=claude:password --realm=north -v
# ============================================================

# -----------------------------------------------------------
# 基础 TURN 服务器配置
# -----------------------------------------------------------

# 监听端口（默认 3478）
listening-port=3478

# TLS 监听端口（可选）
#tls-listening-port=5349

# 监听地址
listening-ip=0.0.0.0

# Relay 地址
relay-ip=0.0.0.0

# 外部 IP 地址（如果使用 NAT）
#external-ip=203.0.113.10

# Realm（认证域）
realm=north

# 认证方式（long-term 机制）
lt-cred-mech

# 测试用户（格式: username:password）
user=claude:password

# 日志级别 (0-7, 7 为最详细)
verbose

# 最小/最大中继端口范围（Turbo 模式下单端口复用，此范围仅用于回退场景）
#min-port=49152
#max-port=65535

# 网络接口名称（Turbo 模式必填，复用标准 listening-device 参数）:
#   DPDK 模式: DPDK 端口 ID 或 PCI 地址（如 "0" 或 "0000:03:00.0"）
#   AF_XDP 模式: Linux 网络接口名（如 "eth0"、"ens3"）
# 对应命令行参数: -d/--listening-device
listening-device=eth0

# -----------------------------------------------------------
# Turbo 高性能模式配置（核心）
# -----------------------------------------------------------

# 启用 Turbo 模式（DPDK/AF_XDP 数据平面加速）
# 注意：必须在编译时包含 -DTURN_USE_DPDK 或 -DTURN_USE_AFXDP
# 标准模式（无 Turbo 编译）设置 turbo=true 会导致启动失败
turbo=true

# Turbo HTTP API 端口（房间管理 REST API）
# 提供以下接口:
#   POST   /v1/room/create  - 创建房间
#   POST   /v1/room/join    - 加入房间
#   DELETE /v1/room/leave   - 离开房间
#   GET    /v1/room/info    - 查询房间信息
#   GET    /v1/room/list    - 列出所有房间
turbo-api-port=9999

# -----------------------------------------------------------
# SSL/TLS 配置（可选）
# -----------------------------------------------------------

# 证书文件
#cert=/etc/turnserver/cert.pem

# 私钥文件
#pkey=/etc/turnserver/privkey.pem

# 密码套件
#cipher-list=DEFAULT

# -----------------------------------------------------------
# 数据库配置（可选）
# -----------------------------------------------------------

# SQLite（默认）
#userdb=/var/lib/turn/turndb

# MySQL
#mysql-userdb="host=localhost dbname=turn user=turn password=turn"

# PostgreSQL
#psql-userdb="host=localhost dbname=turn user=turn password=turn connect_timeout=30"

# Redis（用于 OAuth 和统计）
#redis-userdb="ip=127.0.0.1 dbname=0 password= port=6379 connect_timeout=30"

# -----------------------------------------------------------
# 性能调优（可选）
# -----------------------------------------------------------

# 工作线程数（默认 = CPU 核心数）
#relay-threads=0

# 系统日志
#syslog

# UDP 接收缓冲大小
#udp-receive-buffer-size=0

# 最大带宽 (bytes/sec, 0 表示无限制)
#max-bps=0

# 每用户配额
#user-quota=0

# 总配额
#total-quota=0

# -----------------------------------------------------------
# Conductor 分布式调度配置（多节点集群）
# -----------------------------------------------------------
# 注意: Conductor 是独立进程，不在 turnserver.conf 中配置
# 启动方式:
#   conductor --listen 127.0.0.1 --port 8080 --ws-port 8765 \
#       --redis "redis://127.0.0.1:6379/0" --node-id "conductor-1"
