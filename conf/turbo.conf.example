# ============================================================
# coturn-turbo 配置示例
# ============================================================
# 将此文件复制为 turnserver.conf 并根据实际环境修改参数
#
# 使用方式:
#   turnserver -c turnserver.conf
#
# 或使用命令行参数覆盖:
#   turnserver --turbo --turbo-api-port 9999 -o -a -f \
#       --user=claude:password --realm=north -v
# ============================================================

# -----------------------------------------------------------
# 基础 TURN 服务器配置
# -----------------------------------------------------------

# 监听端口（默认 3478）
listening-port=3478

# TLS 监听端口（可选）
#tls-listening-port=5349

# 外部 IP 地址（如果使用 NAT）
#external-ip=203.0.113.10

# 监听地址
listening-ip=0.0.0.0

# Relay 地址
relay-ip=0.0.0.0

# Realm（认证域）
realm=north

# 认证方式（long-term 机制）
lt-cred-mech

# 测试用户（格式: username:password）
user=claude:password

# 日志级别 (0-7, 7 为最详细)
verbose

# 最小/最大中继端口范围
#min-port=49152
#max-port=65535

# -----------------------------------------------------------
# Turbo 高性能模式配置
# -----------------------------------------------------------

# 启用 Turbo 模式（DPDK/AF_XDP 数据平面加速）
turbo=true

# Turbo HTTP API 端口（房间管理 REST API）
turbo-api-port=9999

# 网络后端选择:
#   dpdk   - 使用 DPDK 网络后端（需 --use-dpdk 编译）
#   afxdp  - 使用 AF_XDP 网络后端（需 --use-afxdp 编译）
# 注意: 后端在编译时确定，此处仅作注释说明
# turbo-backend=dpdk

# 网络接口名称:
#   DPDK 模式: DPDK 端口标识，如 "0000:03:00.0" 或 "0"
#   AF_XDP 模式: Linux 网络接口名，如 "eth0"
# turbo-ifname=eth0

# 最大房间数
# turbo-max-rooms=1024

# 每个房间最大成员数
# turbo-max-members-per-room=256

# -----------------------------------------------------------
# SSL/TLS 配置（可选）
# -----------------------------------------------------------

# 证书文件
#cert=/etc/turnserver/cert.pem

# 私钥文件
#pkey=/etc/turnserver/privkey.pem

# 密码套件
#cipher-list=DEFAULT

# -----------------------------------------------------------
# 数据库配置（可选）
# -----------------------------------------------------------

# SQLite（默认）
#userdb=/var/lib/turnserver/turndb

# MySQL
#psql-userdb=host=localhost dbname=turn user=turn password=turn

# PostgreSQL
#psql-userdb=host=localhost dbname=turn user=turn password=turn connect_timeout=30

# Redis（用于 OAuth 和统计）
#redis-userdb="host=127.0.0.1 dbname=0 port=6379 connect_timeout=30"

# -----------------------------------------------------------
# 性能调优（可选）
# -----------------------------------------------------------

# 工作线程数（默认 = CPU 核心数）
#syslog

# UDP 接收缓冲大小
#udp-receive-buffer-size=0

# 最大带宽 (bytes/sec, 0 表示无限制)
#max-bps=0

# 每用户配额
#user-quota=0

# 总配额
#total-quota=0

# -----------------------------------------------------------
# Conductor 分布式调度配置（多节点集群）
# -----------------------------------------------------------
# 注意: Conductor 是独立进程，不在 turnserver.conf 中配置
# 启动方式:
#   conductor --listen 127.0.0.1 --port 8080 --ws-port 8765 \
#       --redis "redis://127.0.0.1:6379/0" --node-id "conductor-1"
